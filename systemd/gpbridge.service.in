[Unit]
Description=Gamepad bridge (evdev -> USB HID gadget)
Documentation=https://github.com/kchellappan/rpi_gamepad_bridge
Requires=gpb-gadget.service
After=gpb-gadget.service

[Service]
Type=simple

# Which config to run. Rewritten by gpb-web when the user selects a different one.
#
# The input source is NOT set here. It is declared by the config, and only there -- passing
# --source as well meant two places stated the same fact and the flag won silently, so a
# config reading `source = udp` could be running a Unix socket with nothing to say so.
# gpbridge still accepts --source on the command line for one-off testing by hand.
EnvironmentFile=@ENVFILE@
ExecStart=@REPO@/build/gpbridge --config ${GPB_CONFIG} --status @STATEDIR@/status.json

# The bridge already tolerates a missing controller and reconnects on its own, so a
# restart here is for genuine crashes only -- not for the pad being unplugged.
Restart=on-failure
RestartSec=2

# Headroom for the optional real-time settings in the config (bridge.rt_priority,
# and mlockall). Granting the limits costs nothing when they are left at defaults.
LimitRTPRIO=99
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
